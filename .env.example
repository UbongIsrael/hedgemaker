# Privy is optional for local public-preview work. Set all values to enable it.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
VITE_MONAD_CHAIN_ID=
VITE_MONAD_CHAIN_NAME=Monad Testnet
VITE_MONAD_RPC_URL=
VITE_MONAD_EXPLORER_URL=

# Protocol writes remain disabled until these are verified and added to a
# trusted deployment registry. Never paste private keys into Vite env files.

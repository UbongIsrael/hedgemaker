# Privy is optional for local public-preview work. Set all values to enable it.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=
VITE_MONAD_CHAIN_ID=10143
VITE_MONAD_CHAIN_NAME=Monad Testnet
VITE_MONAD_RPC_URL=
VITE_MONAD_EXPLORER_URL=

# HedgeMaker deployment on Monad testnet. These values are public.
VITE_DEPLOYMENT_ID=hedgemaker-monad-testnet-v2
VITE_DEPLOYMENT_BLOCK=70660315
VITE_ACCESS_MANAGER_ADDRESS=0x66A8328EEFF320c47053C279cC31fff4d36A3e5a
VITE_SETTLEMENT_TOKEN_ADDRESS=0x6Ad6053bA7bae4f335C140eB05025D6c5B6cBE52
VITE_VAULT_ADDRESS=0x73Fd808E194e49960fDEa1E1c0943394514428A5
VITE_MARKET_CONFIG_ADDRESS=0xafCb8274B0d9D78A2276cb68B78b2375F6111728
VITE_RATE_ORACLE_ADDRESS=0x2e2e1F5E615c8D5ef3e8F548c9916bD9fa42eb49
VITE_POSITION_MANAGER_ADDRESS=0x80499A64114E50FB2CAa1a3AC55FDbaF10f60227
VITE_ORDER_BOOK_ADDRESS=0x06384b809dF8EF50b0D657a5525B5B0139dfA886

# Operator CLI only. Never prefix private keys with VITE_ and never commit them.
# Supply these from a secure shell or untracked operator env file.
MONAD_TESTNET_RPC_URL=
MONAD_TESTNET_PRIVATE_KEY=
HEDGEMAKER_MARKET_MANIFEST=./config/testnet-market.manifest.json
HEDGEMAKER_ORACLE_PRIVATE_KEY=
HEDGEMAKER_ORACLE_OBSERVATION=./config/oracle-observation.json
HEDGEMAKER_ORACLE_CANDIDATE_ID=

# V2 rehearsal/operator inputs. Comma-separated keys remain operator-side only.
HEDGEMAKER_V2_MANIFEST=./config/testnet-rehearsal.v2.config-3.json
HEDGEMAKER_V2_TEMPLATE=./config/testnet-rehearsal.v2.example.json
HEDGEMAKER_V2_CONFIG_VERSION=3
HEDGEMAKER_DEPLOYMENT_MANIFEST=./config/deployments/monad-testnet-v2.json
HEDGEMAKER_IGNITION_DEPLOYMENT_ID=hedgemaker-v2-monad-testnet-final
HEDGEMAKER_IGNITION_MODULE_ID=HedgeMakerV2RecoveryFinal
HEDGEMAKER_ORACLE_SIGNER_KEYS=
HEDGEMAKER_ORACLE_SIGNER_ADDRESSES=
HEDGEMAKER_RESOLVER_PRIVATE_KEY=
HEDGEMAKER_RESOLVER_ADDRESS=
HEDGEMAKER_KEEPER_PRIVATE_KEYS=
HEDGEMAKER_TEST_TRADER_PRIVATE_KEYS=
HEDGEMAKER_TEST_WALLET_MON_TARGET=0.25
HEDGEMAKER_TEST_WALLET_MUSDC_TARGET=5000
HEDGEMAKER_PRIVY_TEST_WALLET=
HEDGEMAKER_E2E_EVIDENCE_FILE=./config/monad-testnet-v2-config-3-live-e2e.json
HEDGEMAKER_SUBMITTER_MON_TARGET=5.0
HEDGEMAKER_RESOLVER_MON_RESERVE=0.2
HEDGEMAKER_V2_ORACLE_ACTION=
HEDGEMAKER_REHEARSAL_RATE_RAW=
HEDGEMAKER_V2_RESOLUTION_ACTION=
HEDGEMAKER_V2_RESOLUTION_ACCEPT=
HEDGEMAKER_V2_RESOLUTION_RATIONALE=

# Keep protocol writes disabled until the economic config, oracle schedule,
# roles, and listed series are initialized and verified. Never paste private
# keys into Vite env files.

# Public market-maker application handoff. HTTPS application URL takes precedence.
# If no URL is set, use the verified contact email. No in-app data collection.
VITE_MARKET_MAKER_APPLICATION_URL=
VITE_MARKET_MAKER_CONTACT_EMAIL=sheikh@digitalsheikh.co

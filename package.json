{
  "name": "hedgemaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:compile": "hardhat compile",
    "contracts:typecheck": "tsc -p tsconfig.contracts.json",
    "contracts:test": "hardhat test",
    "contracts:test:solidity": "hardhat test solidity",
    "verify:spec": "node scripts/verify-spec-math.mjs",
    "check": "npm run verify:spec && npm run test && npm run contracts:typecheck && npm run contracts:test && npm run lint && npm run build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@privy-io/react-auth": "^3.47.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "hardhat": "^3.18.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}

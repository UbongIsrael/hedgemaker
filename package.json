{
  "name": "hedgemaker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:compile": "hardhat compile",
    "contracts:typecheck": "tsc -p tsconfig.contracts.json",
    "contracts:test": "hardhat test",
    "contracts:deploy:v2": "hardhat ignition deploy ignition/modules/HedgeMakerV2.ts",
    "testnet:v2:bootstrap-keys": "hardhat run scripts/bootstrap-v2-rehearsal-keys.ts",
    "testnet:v2:sync-rpc": "hardhat run scripts/sync-operator-rpc.ts",
    "testnet:v2:pin-operator": "hardhat run scripts/pin-v2-operator-state.ts",
    "testnet:v2:readiness": "hardhat run scripts/check-v2-readiness.ts",
    "testnet:v2:verify-live": "hardhat run --no-compile --build-profile deployment scripts/verify-v2-live.ts --network monadTestnet",
    "testnet:v2:prepare-wallets": "hardhat run --no-compile --build-profile deployment scripts/prepare-v2-test-wallets.ts --network monadTestnet",
    "testnet:v2:rebalance-gas": "hardhat run --no-compile --build-profile deployment scripts/rebalance-v2-rehearsal-gas.ts --network monadTestnet",
    "testnet:v2:e2e-live": "hardhat run --no-compile --build-profile deployment scripts/run-v2-live-e2e.ts --network monadTestnet",
    "testnet:v2:deploy": "hardhat ignition deploy ignition/modules/HedgeMakerV2RecoveryFinal.ts --network monadTestnet --build-profile deployment --deployment-id hedgemaker-v2-monad-testnet-final",
    "testnet:v2:record-deployment": "hardhat run --build-profile deployment scripts/record-v2-deployment.ts --network monadTestnet",
    "testnet:v2:roles": "hardhat run --build-profile deployment scripts/configure-v2-roles.ts --network monadTestnet",
    "testnet:v2:frontend-env": "hardhat run scripts/print-v2-frontend-env.ts",
    "testnet:v2:apply-frontend-env": "hardhat run scripts/apply-v2-frontend-env.ts",
    "testnet:v2:manifest": "hardhat run --build-profile default scripts/materialize-v2-rehearsal.ts",
    "testnet:v2:initialize": "hardhat run --build-profile deployment scripts/initialize-testnet-v2.ts --network monadTestnet",
    "testnet:v2:oracle": "hardhat run --build-profile deployment scripts/operate-oracle-v2.ts --network monadTestnet",
    "testnet:v2:keeper": "hardhat run --no-compile --build-profile deployment scripts/run-v2-oracle-keeper.ts --network monadTestnet",
    "testnet:v2:resolve": "hardhat run --build-profile deployment scripts/resolve-oracle-v2.ts --network monadTestnet",
    "contracts:test:solidity": "hardhat test solidity",
    "testnet:initialize": "hardhat run scripts/initialize-testnet.ts",
    "testnet:oracle:propose": "HEDGEMAKER_ORACLE_ACTION=propose hardhat run scripts/publish-oracle-round.ts",
    "testnet:oracle:finalize": "HEDGEMAKER_ORACLE_ACTION=finalize hardhat run scripts/publish-oracle-round.ts",
    "verify:spec": "node scripts/verify-spec-math.mjs",
    "check": "npm run verify:spec && npm run test && npm run contracts:typecheck && npm run contracts:test && npm run lint && npm run build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@privy-io/react-auth": "^3.47.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "hardhat": "^3.18.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
